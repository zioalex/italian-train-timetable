{
  "name": "italian-train-search",
  "version": "1.0.0",
  "description": "Italian Train Search - Trenitalia, Trenord, Italo",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build:frontend": "cd frontend && npm install && npm run build",
    "build:backend": "tsc",
    "build": "npm run build:frontend && npm run build:backend",
    "build:replit": "npm install && npm run build",
    "start": "node dist/server.js",
    "start:replit": "npm run build:replit && npm start",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18"
  }
}
